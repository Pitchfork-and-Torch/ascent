/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'

/og.jpg
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

/infographic.jpg
  Cache-Control: public, max-age=86400

/infographic.png
  Cache-Control: public, max-age=86400

/infographic-banner.jpg
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600
